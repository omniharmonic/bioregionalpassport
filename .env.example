# Neon Postgres (platform + all pod schemas)
DATABASE_URL=postgresql://user:pass@host/passport?sslmode=require
# 32-byte hex master key used to encrypt pod signing keys at rest (KMS stand-in)
POD_KEY_ENCRYPTION_KEY=
# Platform domain used for did:web hosting and per-pod subdomains
PLATFORM_DOMAIN=bioregionalpassport.org
# Secret for signing session cookies issued after verifyDTG
SESSION_SECRET=
# Break-glass bearer token for platform operator routes (/api/control/*, the tenant-zero job over HTTP).
# Platform-scope operator routes accept only this Bearer token, never a session (ADR-036). Unset disables them.
OPERATOR_TOKEN=
# Pods where the wallet's /wallet/demo simulated phone may create real (demo) members; comma-separated slugs.
NEXT_PUBLIC_DEMO_PODS=tenant-zero
# Static custom-domain map for pods: `domain=slug,domain=slug` (e.g. passport.boulder.coop=boulder).
# Custom domains do not share the platform session cookie; wallet sections still run on the platform origin.
POD_CUSTOM_DOMAINS=
