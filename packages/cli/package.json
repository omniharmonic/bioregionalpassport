{
  "name": "@passport/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "passport": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@passport/appview": "workspace:*",
    "@passport/cc-gateway": "workspace:*",
    "@passport/control-plane": "workspace:*",
    "@passport/credential-core": "workspace:*",
    "@passport/db": "workspace:*",
    "@passport/pod-vta": "workspace:*",
    "@passport/tenant-config": "workspace:*",
    "@passport/vocab": "workspace:*",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
