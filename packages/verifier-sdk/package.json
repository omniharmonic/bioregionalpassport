{
  "name": "@passport/verifier-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vectors/*": "./vectors/*"
  },
  "files": ["dist", "vectors"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "gen-vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@passport/credential-core": "workspace:*",
    "@passport/vocab": "workspace:*",
    "@scure/base": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
